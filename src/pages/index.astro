---
// component script section
import "../styles/global.css";
import Main from "../layouts/Main.astro";
const heroImage = "/Male-and-female-sculpture.jpg";
const redflag = "/redflag.jpg";
---

<!-- component template -->
<Main>
  <div class="hero__wrapper">
    <div class="hero">
      <img alt="Hero image" class="hero__image" src={heroImage} />
    </div>
    <div class="header">
      <div class="header__content">
        <div class="left__header">Tonya Call</div>
        <nav class="main__nav">
          <a href="#">Home</a>
          <a href="#">Books</a>
          <a href="https://femalediary.com">Blog</a>
          <a href="#">Contact</a>
        </nav>
        <div class="right__header">
          <a href="/about">About</a>
        </div>
      </div>
    </div>

	

    <div class="book__section">
      <div class="book">
        <img alt="I'm a red flag" class="red__flag" src={redflag} />
      </div>
      <div class="buy__wrapper">
        <a href="https://www.amazon.com/your-book-link"
         target="_blank"
         rel="noopener noreferrer"
         class="buy__button">
        Buy Now!
      </a>
      </div>
      
    </div>

    <div class="book__description__wrapper">
      <!-- placeholder for future right-side content -->
       <h1>I'm the Red Flag</h1>
       <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Nulla nisi dolore possimus maxime. Laboriosam itaque, veniam, non id minus distinctio aliquam asperiores ad debitis placeat ut corrupti, quas consequatur quam.</p>
    </div>
  
  
  </div>

  
</Main>

<style>
  .hero__wrapper {
    position: relative;
    width: 100%;
   
    
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
    background-repeat: no-repeat;
  }

  .header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    width: 100%;
    background-color: transparent;
  }

  .header__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
  }

  .main__nav {
    display: flex;
    gap: 1.5rem;
    
  }

  .main__nav a,
  .right__header a {
    text-decoration: none;
    color: black;
    font-size: 1.25rem;
  }

  .right__header,
  .left__header {
    font-weight: bold;
    font-size: 1.45rem;
    font-color: black;
  }

  .book__wrapper {

  }

  .book__section {
    position: absolute;
    top: 175px;
    left: 300px;
  	margin: 20px;
  }

  .book {
    margin-bottom: 1rem;
  }

  .red__flag {
    width: clamp(120px, 20vw, 600px);
    height: auto;
  }

  .buy__wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: auto;
    
  }

  .buy__button {
    
    margin-left: auto;
    margin-right: auto;
	  padding: .5rem 1rem;
	  text-decoration: none;
	  border: 2px solid red;
    outline-color: transparent;
	  background-color: #8fbc8f;
    font-size: 1rem;
    border-radius: 25%;
	  text-align: center;
    cursor: pointer;
    transition-duration:  0.2s ease-in-out;
  }

  .buy__button:is(:hover, :focus) {
    box-shadow: 0 0 3px 3px;
    background-color: #8fbc8f;
	
  }

  .book__description__wrapper {
    display: grid;
    grid-template-columns: "book description";
    
  }

@media (max-width: 768px) {
  .book__overlay {
    position: static;         /* remove absolute layout */
    margin-top: 2rem;
    flex-direction: column;
    align-items: center;
  }

  .hero__wrapper {
    height: auto;             /* allow content to expand */
  }
}

</style>
