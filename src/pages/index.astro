---
// component script section
import "../styles/global.css";
import Main from "../layouts/Main.astro";
const heroImage = "/Male-and-female-sculpture.jpg";
const redflag = "/redflag.jpg";
---

<!-- component template -->
<Main>
  <div class="hero__wrapper">
    <div class="hero">
      <img alt="Hero image" class="hero__image" src={heroImage} />
    </div>
    <div class="header">
      <div class="header__content">
        <div class="left__header">Tonya Call</div>
        <nav class="Main__nav">
          <a href="#">Home</a>
          <a href="#">Books</a>
          <a href="https://femalediary.com">Blog</a>
          <a href="#">Contact</a>
        </nav>
        <div class="right__header">
          <a href="/about">About</a>
        </div>
      </div>
    </div>

	
    <div class="book__section">
      <div class="book">
        <img alt="I'm a red flag" class="red__flag" src={redflag} />
      </div>
      <div class="buy__button">
        <button type="button">Buy Now!</button>
      </div>
    </div>
  
  </div>

  
</Main>

<style>
  .hero__wrapper {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
  }

  .header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    width: 100%;
    background-color: transparent;
  }

  .header__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
  }

  .Main__nav {
    display: flex;
    gap: 1.5rem;
  }

  .Main__nav a,
  .right__header a {
    text-decoration: none;
    color: black;
    font-size: 1rem;
  }

  .right__header,
  .left__header {
    font-weight: bold;
    font-size: 1.25rem;
    font-color: black;
  }


  .book__section {
    position: absolute;
	top: 15%;
	left: 60%;
	transform: translate(-50%, -50%)
    margin-top: 3rem;
  }

  .book {
    margin-bottom: 1rem;
  }

  .red__flag {
    width: 300px;
    height: auto;
  }

  .buy__button {
    outline-color: transparent;
    color: #fffdd0;
    font-size: 1rem;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.2s ease-in-out;
  }

  .buy__button:is(:hover, :focus) {
    box-shadow: 0 0 3px 3px;
    background-color: #6495ed;
  }
</style>
