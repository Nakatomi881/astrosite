---

// component script section 
import "../styles/global.css";
import Main from "../layouts/Main.astro"
const heroImage = "/Male-and-female-sculpture.jpg"
---
<!-- component template -->

<Main>
	<div class="hero__wrapper">
		<div class="hero">
			<img
				alt="Hero image"
				width= "100%"
				class= "hero__image"
				src= {heroImage}
							
			/>
		</div>
	<div class="header">
	 <div class="header__content">
	<div class="left__header">
		Tonya Call
	</div>
		<nav class="Main__nav">
			<a href="#">Home</a>
			<a href="#">Books</a>
			<a href="https://femalediary.com">Blog</a>
			<a href="#">Contact</a>
		</nav>
		<div class="right__header">
			<a href="#">About</a>
		</div>
		</div>
	</div>
	
	</div>
</Main>


<style>
	.hero__wrapper {
		position: relative;
		width: 100%;
		height: 100vh;
		overflow: hidden;
	}
	
	.hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.10;
		
	}

	.header {
		position: absolute;
  		top: 0;
  		left: 0;
  		z-index: 10;
  		width: 100%;
  		background-color: transparent;

	}
	
	.header__content {
  		display: flex;
  		justify-content: space-between;
  		align-items: center;
  		max-width: 1200px;
  		margin: 0 auto;
  		padding: 1rem 2rem;
}
	
	.Main__nav {
		display: flex;
		gap: 1.5rem;
		
	}

	.Main__nav a, .right__header a{
		text-decoration: none;
		color: black;
		font-size: 1rem;
	}
	
	.right__header, .left__header {
		font-weight: bold;
		font-size: 1.25rem;
		font-color: black;
	}
	
</style>

